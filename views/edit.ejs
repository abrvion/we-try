
<%- include("partials/header", { title: "Edit Post - My Blog" }) %>

<section class="form-section">

    <div class="form-header">
        <h1>Edit Post</h1>
        <p>Update your blog post.</p>
    </div>

    <form action="/edit/<%= id %>" method="POST" class="post-form">

        <div class="form-group">
            <label for="title">Post Title</label>

            <input
                type="text"
                id="title"
                name="title"
                value="<%= post.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="content">Post Content</label>

            <textarea
                id="content"
                name="content"
                rows="12"
                required
            ><%= post.content %></textarea>
        </div>

        <div class="form-actions">
            <a href="/post/<%= id %>" class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Update Post
            </button>
        </div>

    </form>

</section>

<%- include("partials/footer") %>

